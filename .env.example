MYSQL_URL=jdbc:mysql://localhost:3306/user_management?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-strong-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-a-60-character-bcrypt-hash
REDIS_PASSWORD=replace-with-a-strong-redis-password
JWT_TTL_SECONDS=86400
JWT_RSA_PRIVATE_KEY=replace-with-pkcs8-private-key-base64
JWT_RSA_PUBLIC_KEY=replace-with-x509-public-key-base64
INTERNAL_SERVICE_KEY=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=900
APOLLO_ENABLED=true
APOLLO_REQUIRED=true
CONTAINER_PREFIX=risk
APOLLO_META=http://host.docker.internal:8080
APOLLO_NAMESPACES=application,database,security,risk
GATEWAY_PORT=8088
VITE_GATEWAY_TARGET=http://localhost:8088
PUBLIC_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
MQ_ENABLED=true
ROCKETMQ_NAMESRV_ADDR=rocketmq-namesrv:9876
MAIL_MQ_TOPIC=risk-mail-topic
MAIL_MQ_TAG=mail-send
MAIL_MQ_CONSUME_ENABLED=true
MAIL_SEND_ENABLED=false
