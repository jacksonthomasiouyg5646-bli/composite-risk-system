        <trim prefix="(" suffix=")" suffixOverrides=","><if test="name != null">name,</if><if test="code != null">code,</if><if test="module != null">module,</if><if test="description != null">description,</if></trim>
        <trim prefix="values (" suffix=")" suffixOverrides=","><if test="name != null">#{name},</if><if test="code != null">#{code},</if><if test="module != null">#{module},</if><if test="description != null">#{description},</if></trim>
    </insert>
    <update id="updatePermission">update sys_permission <set><if test="body.name != null">name=#{body.name},</if><if test="body.code != null">code=#{body.code},</if><if test="body.module != null">module=#{body.module},</if><if test="body.description != null">description=#{body.description},</if></set> where id=#{id}</update>
    <delete id="deletePermission">delete from sys_permission where id = #{id}</delete>

    <select id="listDepartments" resultType="map">select * from sys_department <if test="keyword != null and keyword != ''">where name like concat('%', #{keyword}, '%')</if> order by id desc limit #{limit} offset #{offset}</select>
    <select id="countDepartments" resultType="long">select count(*) from sys_department <if test="keyword != null and keyword != ''">where name like concat('%', #{keyword}, '%')</if></select>
    <select id="getDepartment" resultType="map">select * from sys_department where id = #{id}</select>
    <insert id="insertDepartment" parameterType="map" useGeneratedKeys="true" keyProperty="id">
        insert into sys_department
        <trim prefix="(" suffix=")" suffixOverrides=","><if test="tenant_id != null">tenant_id,</if><if test="parent_id != null">parent_id,</if><if test="name != null">name,</if><if test="code != null">code,</if><if test="leader != null">leader,</if><if test="phone != null">phone,</if><if test="sort_order != null">sort_order,</if><if test="status != null">status,</if></trim>
        <trim prefix="values (" suffix=")" suffixOverrides=","><if test="tenant_id != null">#{tenant_id},</if><if test="parent_id != null">#{parent_id},</if><if test="name != null">#{name},</if><if test="code != null">#{code},</if><if test="leader != null">#{leader},</if><if test="phone != null">#{phone},</if><if test="sort_order != null">#{sort_order},</if><if test="status != null">#{status},</if></trim>
    </insert>
    <update id="updateDepartment">update sys_department <set><if test="body.tenant_id != null">tenant_id=#{body.tenant_id},</if><if test="body.parent_id != null">parent_id=#{body.parent_id},</if><if test="body.name != null">name=#{body.name},</if><if test="body.code != null">code=#{body.code},</if><if test="body.leader != null">leader=#{body.leader},</if><if test="body.phone != null">phone=#{body.phone},</if><if test="body.sort_order != null">sort_order=#{body.sort_order},</if><if test="body.status != null">status=#{body.status},</if></set> where id=#{id}</update>
    <delete id="deleteDepartment">delete from sys_department where id = #{id}</delete>

    <select id="listPosts" resultType="map">select * from sys_post <if test="keyword != null and keyword != ''">where name like concat('%', #{keyword}, '%')</if> order by id desc limit #{limit} offset #{offset}</select>
    <select id="countPosts" resultType="long">select count(*) from sys_post <if test="keyword != null and keyword != ''">where name like concat('%', #{keyword}, '%')</if></select>
    <select id="getPost" resultType="map">select * from sys_post where id = #{id}</select>
    <insert id="insertPost" parameterType="map" useGeneratedKeys="true" keyProperty="id">
        insert into sys_post
        <trim prefix="(" suffix=")" suffixOverrides=","><if test="tenant_id != null">tenant_id,</if><if test="name != null">name,</if><if test="code != null">code,</if><if test="sort_order != null">sort_order,</if><if test="status != null">status,</if></trim>
        <trim prefix="values (" suffix=")" suffixOverrides=","><if test="tenant_id != null">#{tenant_id},</if><if test="name != null">#{name},</if><if test="code != null">#{code},</if><if test="sort_order != null">#{sort_order},</if><if test="status != null">#{status},</if></trim>
    </insert>
    <update id="updatePost">update sys_post <set><if test="body.tenant_id != null">tenant_id=#{body.tenant_id},</if><if test="body.name != null">name=#{body.name},</if><if test="body.code != null">code=#{body.code},</if><if test="body.sort_order != null">sort_order=#{body.sort_order},</if><if test="body.status != null">status=#{body.status},</if></set> where id=#{id}</update>
    <delete id="deletePost">delete from sys_post where id = #{id}</delete>

    <select id="listMenus" resultType="map">select * from sys_menu <if test="keyword != null and keyword != ''">where title like concat('%', #{keyword}, '%')</if> order by id desc limit #{limit} offset #{offset}</select>
    <select id="countMenus" resultType="long">select count(*) from sys_menu <if test="keyword != null and keyword != ''">where title like concat('%', #{keyword}, '%')</if></select>
    <select id="getMenu" resultType="map">select * from sys_menu where id = #{id}</select>
    <insert id="insertMenu" parameterType="map" useGeneratedKeys="true" keyProperty="id">
        insert into sys_menu
        <trim prefix="(" suffix=")" suffixOverrides=","><if test="parent_id != null">parent_id,</if><if test="title != null">title,</if><if test="path != null">path,</if><if test="component != null">component,</if><if test="icon != null">icon,</if><if test="permission_code != null">permission_code,</if><if test="sort_order != null">sort_order,</if><if test="visible != null">visible,</if></trim>
        <trim prefix="values (" suffix=")" suffixOverrides=","><if test="parent_id != null">#{parent_id},</if><if test="title != null">#{title},</if><if test="path != null">#{path},</if><if test="component != null">#{component},</if><if test="icon != null">#{icon},</if><if test="permission_code != null">#{permission_code},</if><if test="sort_order != null">#{sort_order},</if><if test="visible != null">#{visible},</if></trim>
    </insert>
    <update id="updateMenu">update sys_menu <set><if test="body.parent_id != null">parent_id=#{body.parent_id},</if><if test="body.title != null">title=#{body.title},</if><if test="body.path != null">path=#{body.path},</if><if test="body.component != null">component=#{body.component},</if><if test="body.icon != null">icon=#{body.icon},</if><if test="body.permission_code != null">permission_code=#{body.permission_code},</if><if test="body.sort_order != null">sort_order=#{body.sort_order},</if><if test="body.visible != null">visible=#{body.visible},</if></set> where id=#{id}</update>
